@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(LiaraInterfaces)
# Private to the module, but a static liara_renderer carries them into its consumers' link interface.
find_dependency(VulkanHeaders)
find_dependency(VulkanMemoryAllocator)

include("${CMAKE_CURRENT_LIST_DIR}/LiaraRendererTargets.cmake")

check_required_components(LiaraRenderer)