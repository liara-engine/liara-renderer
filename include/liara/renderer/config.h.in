#pragma once

#include <liara/version.h>

#define LIARA_RENDERER_VERSION LIARA_MAKE_VERSION_UNSAFE( \
    @PROJECT_VERSION_MAJOR@,                              \
    @PROJECT_VERSION_MINOR@,                              \
    @PROJECT_VERSION_PATCH@                               \
)

#define LIARA_RENDERER_MAJOR_VERSION @PROJECT_VERSION_MAJOR@
#define LIARA_RENDERER_MINOR_VERSION @PROJECT_VERSION_MINOR@
#define LIARA_RENDERER_PATCH_VERSION @PROJECT_VERSION_PATCH@

#define LIARA_RENDERER_VERSION_STRING "@PROJECT_VERSION@"
